# Copy this file to .env (same folder) and fill it in. .env is git-ignored: never commit it.
# Real environment variables of the same names win over this file.

# Wi-Fi network for the end-to-end tests (test/e2e/test_wifi.py)
USR_MODEM_WIFI_SSID=
USR_MODEM_WIFI_PASS=

# Device password (OTA and web); OTA upload: pio run -e s3_ota -t upload
USR_MODEM_PASSWORD=
