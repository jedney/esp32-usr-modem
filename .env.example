# Copy this file to .env (same folder) and fill it in. .env is git-ignored: never commit it.
# Real environment variables of the same names win over this file.

# Wi-Fi network for the end-to-end tests (test/e2e/test_wifi.py)
USR_MODEM_WIFI_SSID=
USR_MODEM_WIFI_PASS=

# Device password (OTA and web); OTA upload: pio run -e s3_ota -t upload
USR_MODEM_PASSWORD=

# SSH server with password login for test/e2e/test_ssh.py (host or host:port; port 22 if
# omitted). Used only by the test fixture; never printed.
USR_MODEM_SSH_TEST_HOST=
USR_MODEM_SSH_TEST_USER=
USR_MODEM_SSH_TEST_PASS=

# GPIO pin map. These are the defaults the firmware is built
# with; .env.example is always read first, then .env, then real environment variables.
# Change them only when the board changes. See lib/hw/src/pins.h for the header layout.
# If .env changes any pin on purpose (a bench board), also set USR_MODEM_PINS_OVERRIDDEN=1
# in .env. Without it the pin-lock unit test fails, which stops uploads.
# Not allowed: GPIO22-25 (absent), 26-37 (flash/PSRAM), 19/20 (USB modem port); POT: 1-10.
# USR_MODEM_PINS_OVERRIDDEN=1
# RS232 (UART1) via the RS232 Pal modules, DCE: modem outputs
USR_MODEM_PIN_RXD=1
USR_MODEM_PIN_CTS=42
USR_MODEM_PIN_DCD=39
USR_MODEM_PIN_RI=38
# RS232 modem inputs
USR_MODEM_PIN_TXD=2
USR_MODEM_PIN_RTS=41
USR_MODEM_PIN_DTR=40
# Audio (MAX98357A)
USR_MODEM_PIN_I2S_LRC=11
USR_MODEM_PIN_I2S_BCLK=12
USR_MODEM_PIN_I2S_DIN=13
USR_MODEM_PIN_AMP_SD=14
# Volume pot wiper (must be ADC1, GPIO1-10)
USR_MODEM_PIN_POT=10
# Front-panel LEDs
USR_MODEM_PIN_LED_AA=4
USR_MODEM_PIN_LED_CD=5
USR_MODEM_PIN_LED_RD=6
USR_MODEM_PIN_LED_SD=7
USR_MODEM_PIN_LED_TR=15
USR_MODEM_PIN_LED_CS=16
USR_MODEM_PIN_LED_ARQ=17
# On the S3 board
USR_MODEM_PIN_CONSOLE_TX=43
USR_MODEM_PIN_CONSOLE_RX=44
# Test-only UART2 (nothing wired)
USR_MODEM_PIN_TEST_UART_TX=18
USR_MODEM_PIN_TEST_UART_RX=8
