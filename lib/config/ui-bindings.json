  },
  "settings.model": {
    "screen": "Settings",
    "command": "*MODEL=",
    "help": "14400|28800|33600|56000; saved immediately",
    "target": "Settings",
    "input": true
  },
  "settings.auto-answer-rings": {
    "screen": "Settings",
    "command": "*SETTING=S0=",
    "help": "0 disables auto-answer; 1-255 rings; &W saves",
