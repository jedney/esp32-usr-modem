    "input": true
  },
  "settings.auto-answer-destination": {
    "screen": "Settings",
    "command": "*ANSWERPORT=",
    "help": "RS232|CONSOLE; saved immediately",
    "target": "Settings",
    "input": true
  },
  "settings.host-baud": {
    "screen": "Settings",
    "command": "*BAUD=",
    "help": "AUTO|300-115200; saved immediately; console fixed 115200",
    "target": "Settings",
    "input": true,
    "secret": false,
    "rs232Unavailable": false,
    "leave": true
  },
  "settings.data-throttle": {
    "screen": "Settings",
    "command": "*THROTTLE=",
    "help": "ON|OFF; saved immediately",
    "target": "Settings",
    "input": true
  },
