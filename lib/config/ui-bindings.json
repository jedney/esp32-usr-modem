{
  "status": {
    "screen": "Main",
    "command": "*STATUS",
    "help": "Call, front panel, network and host serial",
    "target": "Main"
  },
  "phonebook": {
    "screen": "Main",
    "command": "",
    "help": "List, add, edit, delete and dial",
    "target": "Phonebook"
  },
  "phonebook.list-entries": {
    "screen": "Phonebook",
    "command": "*PHONEBOOK?",
    "help": "64 entries; number 1 is Amiga Retro BBS by default",
    "target": "Phonebook"
  },
  "phonebook.add-edit-entry": {
    "screen": "Phonebook",
    "command": "*PHONEBOOK=",
    "help": "number,host,port,TELNET|RAW[,speed]; saved immediately",
    "target": "Phonebook",
    "input": true
  },
  "phonebook.delete-entry": {
    "screen": "Phonebook",
    "command": "*PHONEDELETE=",
    "help": "number; saved immediately",
    "target": "Phonebook",
    "input": true
  },
  "phonebook.dial": {
    "screen": "Phonebook",
    "command": "*DIAL=",
    "help": "phonebook number or host:port; leaves menu",
    "target": "Phonebook",
    "input": true,
    "secret": false,
    "rs232Unavailable": false,
    "leave": true
  },
  "settings": {
    "screen": "Main",
    "command": "",
    "help": "Settings and help",
    "target": "Settings"
  },
  "settings.current-stored-profiles": {
