  "description": "Four Sportster variants, main menu and full nested inventory. Keys are UI-local; route by stable IDs. 80x25 mode is first-class.",
  "model_selection": {
    "command": "AT*MODEL",
    "policy": "Read the active model from existing app/device state linked to AT*MODEL. Do not assume a command argument format, issue AT commands, or change device state just to render the menu. If unknown, use an explicit unknown state rather than defaulting silently."
  },
  "layout": {
    "compact": {
      "columns": 80,
      "rows": 25,
      "main_menu": "two-columns, abbreviated labels, 7 rows; never hide an entry",
      "submenus": "single pane or paginate/scroll for longer lists; fixed header/footer",
      "padding": "exact 80 visible cells per row including outer frame"
    },
    "wide": {
      "min_columns": 120,
      "recommended_rows": 45,
      "main_menu": "detailed two-column reference layout",
      "submenus": "optional split panes like Phonebook screenshot"
    }
  }
